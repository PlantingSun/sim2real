<mujoco model="go2w_scene">
  <include file="go2w.xml"/>

  <statistic center="0 0 0.1" extent="0.8"/>

  <visual>
    <headlight diffuse="0.5 0.5 0.5" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
      height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
      rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
      reflectance="0.2"/>
    <material name="wmp_stair" rgba="0.72 0.46 0.18 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" diffuse="0.5 0.5 0.5" specular="0.1 0.1 0.1"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!--
      WMP stairs: five 0.12 m rises, each tread is 0.25 m deep and 0.60 m wide.
      The staircase is centered on y=0 and starts at x=0.80 m (+x is forward).
      The fifth descending level is a ground-level landing, so the floor completes the
      final 0.12 m drop without adding overlapping collision geometry.
      Solid stacked boxes avoid gaps below the raised treads.
    -->
    <geom name="wmp_stair_up_1" type="box" pos="0.925 0 0.06" size="0.125 0.30 0.06" material="wmp_stair"/>
    <geom name="wmp_stair_up_2" type="box" pos="1.175 0 0.12" size="0.125 0.30 0.12" material="wmp_stair"/>
    <geom name="wmp_stair_up_3" type="box" pos="1.425 0 0.18" size="0.125 0.30 0.18" material="wmp_stair"/>
    <geom name="wmp_stair_up_4" type="box" pos="1.675 0 0.24" size="0.125 0.30 0.24" material="wmp_stair"/>
    <geom name="wmp_stair_up_5" type="box" pos="1.925 0 0.30" size="0.125 0.30 0.30" material="wmp_stair"/>

    <geom name="wmp_stair_down_1" type="box" pos="2.175 0 0.24" size="0.125 0.30 0.24" material="wmp_stair"/>
    <geom name="wmp_stair_down_2" type="box" pos="2.425 0 0.18" size="0.125 0.30 0.18" material="wmp_stair"/>
    <geom name="wmp_stair_down_3" type="box" pos="2.675 0 0.12" size="0.125 0.30 0.12" material="wmp_stair"/>
    <geom name="wmp_stair_down_4" type="box" pos="2.925 0 0.06" size="0.125 0.30 0.06" material="wmp_stair"/>
    <geom name="wmp_stair_down_5" type="box" pos="3.175 0 -0.01" size="0.125 0.30 0.01" material="wmp_stair"/>
  </worldbody>
</mujoco>
