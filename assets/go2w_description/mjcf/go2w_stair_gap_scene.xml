<mujoco model="go2w_stair_gap_scene">
  <include file="go2w.xml"/>

  <statistic center="0 0 0.2" extent="1.2"/>

  <visual>
    <headlight diffuse="0.5 0.5 0.5" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="obstacle" rgba="0.4 0.4 0.45 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.0" dir="0 0 -1" directional="true" diffuse="0.5 0.5 0.5" specular="0.1 0.1 0.1"/>

    <!-- plane -->
    <geom name="floor_back" size="0.0 0.0 0.05" type="plane" material="groundplane"/>

    <!-- First up-step -->
    <geom name="step_up_1" pos="1.1425 0 0.085" size="0.1425 1.14 0.085" type="box" material="obstacle"/>
    <geom name="step_up_2" pos="1.4275 0 0.17" size="0.1425 1.14 0.17" type="box" material="obstacle"/>
    <geom name="step_up_3" pos="1.7125 0 0.255" size="0.1425 1.14 0.255" type="box" material="obstacle"/>
    <geom name="step_up_4" pos="1.9975 0 0.34" size="0.1425 1.14 0.34" type="box" material="obstacle"/>

    <!-- Box and Gap -->
    <geom name="box1" pos="2.39 0.0 0.34" size="0.5 1.14 0.34" type="box" material="obstacle"/>
    <geom name="box2" pos="3.39 0.0 0.34" size="0.5 1.14 0.34" type="box" material="obstacle"/>

    <!-- Second down-step -->
    <geom name="step_down_1" pos="4.7825 0 0.34" size="0.1425 1.14 0.34" type="box" material="obstacle"/>
    <geom name="step_down_2" pos="5.0675 0 0.255" size="0.1425 1.14 0.255" type="box" material="obstacle"/>
    <geom name="step_down_3" pos="5.3525 0 0.17" size="0.1425 1.14 0.17" type="box" material="obstacle"/>
    <geom name="step_down_4" pos="5.6375 0 0.085" size="0.1425 1.14 0.085" type="box" material="obstacle"/>

  </worldbody>
</mujoco>
