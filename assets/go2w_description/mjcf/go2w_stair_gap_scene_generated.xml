<?xml version="1.0" encoding="utf-8"?>
<mujoco model="go2w_stair_gap_scene">
  <include file="go2w.xml"/>

  <statistic center="0 0 0.2" extent="1.2"/>

  <visual>
    <headlight diffuse="0.5 0.5 0.5" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="obstacle" rgba="0.4 0.4 0.45 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.0" dir="0 0 -1" directional="true" diffuse="0.5 0.5 0.5" specular="0.1 0.1 0.1"/>

    <!-- plane -->
    <geom name="floor_back" size="0.0 0.0 0.05" type="plane" material="groundplane"/>

    <!-- Up steps -->
    <geom name="step_up_1" pos="2.1 0 0.05" size="0.1 0.5 0.05" type="box" material="obstacle"/>
    <geom name="step_up_2" pos="2.3 0 0.1" size="0.1 0.5 0.1" type="box" material="obstacle"/>
    <geom name="step_up_3" pos="2.5 0 0.15" size="0.1 0.5 0.15" type="box" material="obstacle"/>

    <!-- Gap -->
    <geom name="box1" pos="3.6 0.0 0.15" size="1 0.5 0.15" type="box" material="obstacle"/>
    <geom name="box2" pos="6.2 0.0 0.15" size="1 0.5 0.15" type="box" material="obstacle"/>

    <!-- Down steps -->
    <geom name="step_down_1" pos="7.3 0 0.15" size="0.1 0.5 0.15" type="box" material="obstacle"/>
    <geom name="step_down_2" pos="7.5 0 0.1" size="0.1 0.5 0.1" type="box" material="obstacle"/>
    <geom name="step_down_3" pos="7.7 0 0.05" size="0.1 0.5 0.05" type="box" material="obstacle"/>

  </worldbody>

</mujoco>
