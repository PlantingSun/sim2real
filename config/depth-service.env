# systemd EnvironmentFile; whitespace-free network interface and topic.
DEPTH_INTERFACE=eth0
DEPTH_DOMAIN=42
DEPTH_TOPIC=rt/depth/image64
# Current USB2 480x270@60 needs a 1/64 invalid bottom border for the 58-degree target.
# Remove --allow-partial-fov after switching to a full-coverage USB3 profile.
# No shell expansion; pin the physically verified camera.
DEPTH_EXTRA_ARGS="--serial 336222074436 --allow-partial-fov"
